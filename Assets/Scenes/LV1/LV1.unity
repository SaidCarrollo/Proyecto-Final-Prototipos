  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Para completar el nivel de la forma correcta deber\xE1s manipular la <color=#B1FF9E><b>tapa
    de la sart\xE9n</b></color> o el <color=#B1FF9E><b>trapo</b></color>.\r\n- La
    <color=#B1FF9E><b>tapa</b></color> solo requiere dos acciones. (<color=#B1FF9E><b>Sostener</b></color>
    y <color=#B1FF9E><b>cubrir la sart\xE9n</b></color>)\r\n- El <color=#B1FF9E><b>trapo</b></color>
    requiere tres acciones. (<color=#B1FF9E><b>Sostener</b></color>, <color=#B1FF9E><b>humedecer</b></color>
    y <color=#B1FF9E><b>cubrir la sart\xE9n</b></color>)\r\n\r\nPara obtener <color=#EBFF00><b>insignias</b></color>
    antes de completar el nivel puedes:\r\n- <color=#EBFF00><b>Cerrar</b></color>
    la <color=#EBFF00><b>perilla de la cocina</b></color>.\r\n- <color=#EBFF00><b>Cerrar</b></color>
    la <color=#EBFF00><b>ventana</b></color>.\r\n\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a960a9f0b381e164688e6501ec24984c, type: 2}
  m_sharedMaterial: {fileID: 6997231625079275983, guid: a960a9f0b381e164688e6501ec24984c, type: 2}
